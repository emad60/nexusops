# =============================================================================
# NexusOps environment configuration
#
# Copy to `.env` and adjust. NEVER commit the real .env file.
# Generate strong secrets with:  ./scripts/generate_secrets.sh
# =============================================================================

# --- Core ---
# development | production. Controls docs exposure, cookie Secure flag, error detail.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexusops
POSTGRES_USER=nexusops
# CHANGE ME — used by the postgres container and the API.
POSTGRES_PASSWORD=change-me-postgres
# Full DSN. If unset it is assembled from POSTGRES_* above.
# DATABASE_URL=postgresql+psycopg://nexusops:change-me-postgres@postgres:5432/nexusops
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# JWT signing secret. MUST be >= 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_dev_only_jwt_secret_replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
# Access token lifetime (minutes). Short-lived, held in memory by the SPA.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token lifetime (days). HttpOnly SameSite=Strict cookie, rotated on use.
REFRESH_TOKEN_TTL_DAYS=14
# Grace window (seconds) in which a replay of the immediately-superseded
# refresh token is rescued instead of treated as theft (a browser navigation
# can abort an in-flight refresh after the server committed the rotation).
# One rescue per token, audited; 0 disables.
REFRESH_GRACE_SECONDS=30
# Fernet key for secret encryption at rest. Generate: uv run scripts/generate_secrets.sh
ENCRYPTION_KEY=CHANGE_ME_generate_with_scripts_generate_secrets_sh
# Comma-separated list of allowed browser origins. No trailing slash.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
# Max failed logins before temporary lockout, and lockout duration (seconds).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Simulation mode ---
# When true, seeded servers/containers/metrics are simulated end-to-end so the
# whole platform runs on a laptop with no real infrastructure.
SIMULATION_MODE=true

# --- Heartbeat / monitoring ---
# A server is marked OFFLINE if no heartbeat for this many seconds.
SERVER_OFFLINE_AFTER_SECONDS=90
MONITOR_DISPATCH_INTERVAL_SECONDS=10
METRICS_AGGREGATION_INTERVAL_SECONDS=60
RAW_METRIC_RETENTION_HOURS=24
HOURLY_METRIC_RETENTION_DAYS=30

# --- SMTP (email notifications; Mailpit in dev) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nexusops@example.com
SMTP_TLS=false

# --- SSRF guard ---
# Allow monitors/webhooks to target private networks (dev/simulation only!).
ALLOW_PRIVATE_TARGETS=true

# --- HTTP server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# --- Frontend (dev server) ---
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=

# --- Ports (host mappings used by docker-compose) ---
NEXUSOPS_HTTP_PORT=8080
NEXUSOPS_VITE_PORT=5173
NEXUSOPS_POSTGRES_PORT=5433
NEXUSOPS_REDIS_PORT=6390
NEXUSOPS_MAILPIT_HTTP_PORT=8025
NEXUSOPS_MAILPIT_SMTP_PORT=1025
