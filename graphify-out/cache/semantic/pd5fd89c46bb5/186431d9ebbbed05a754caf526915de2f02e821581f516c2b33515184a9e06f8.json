{"nodes": [{"id": "docs_architecture_md_document", "label": "docs/architecture.md - system architecture", "file_type": "document", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_md_request_lifecycle", "label": "Request lifecycle (edge -> middleware -> rate limit -> deps -> router)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_md_modular_monolith", "label": "Modular monolith topology (one API image, Celery worker/beat)", "file_type": "rationale", "rationale": "One codebase, two entrypoints (backend/app/main.py and backend/app/tasks/celery_app.py); a microservice split would add ops cost with no benefit at this scale.", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_md_websocket_hub", "label": "WebSocket hub (framework-thin, Redis fan-in, per-socket queues)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_md_event_bus", "label": "Real-time spine: PostgreSQL system_events + Redis pub/sub", "file_type": "rationale", "rationale": "The DB row is the source of truth and replayable; Redis carries only best-effort live fan-out, so a Redis outage never loses history.", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_md_deployment_engine", "label": "Deployment engine (queue_deployment / execute_deployment / sweeper backstop)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_md_rollback_as_new_deployment", "label": "Rollback as a new deployment (rollback_of_id)", "file_type": "rationale", "rationale": "Only SUCCESS or FAILED deployments can be rolled back to the most recent successful non-rollback deployment; history stays append-only and rollbacks have their own numbers, logs and audit entries.", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_md_rbac_registry", "label": "RBAC registry (PERMISSIONS + ROLE_MATRIX + scope_matches)", "file_type": "rationale", "rationale": "Permissions are data, not code paths: custom roles are first-class and no role == string checks exist anywhere; checks are centralized in require_permission.", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_md_audit_append_only_trigger", "label": "Append-only audit log (Postgres BEFORE UPDATE OR DELETE trigger)", "file_type": "rationale", "rationale": "Immutability is enforced by the database, not the app: even a compromised or buggy application DB role cannot rewrite or erase history; corrections are new rows.", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_md_scheduling_model", "label": "Scheduling model (fixed beat cadences + FOR UPDATE SKIP LOCKED claims)", "file_type": "rationale", "rationale": "Beat fires fixed cadences only; dynamic scheduling lives in the DB and is claimed with FOR UPDATE SKIP LOCKED so overlapping ticks or extra workers partition work instead of duplicating it; beat stays dumb and restartable.", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_md_secrets_encryption", "label": "Fernet encryption at rest (ENCRYPTION_KEY, write-once)", "file_type": "rationale", "rationale": "Fernet per-value encryption: compromise of a DB dump alone is not enough, consumers resolve values server-side, plaintext is never returned after creation, and rotating the key makes stored secrets undecryptable.", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_architecture_md_document", "target": "docker_compose_yml_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_md_document", "target": "docker_compose_dev_yml_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture.md", "source_location": null, "weight": 1.0}, {"source": "readme_simulation_mode", "target": "docker_compose_yml_scheduler_service", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_md_request_lifecycle", "target": "docker_compose_yml_nginx_service", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_md_request_lifecycle", "target": "docs_api_md_rate_limiting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_md_request_lifecycle", "target": "docs_api_md_error_envelope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/a