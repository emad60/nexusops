{"nodes": [{"id": "docs_deployment_md_document", "label": "docs/deployment.md - deployment and operations guide", "file_type": "document", "source_file": "docs/deployment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_deployment_md_first_boot_sequence", "label": "First boot sequence (api entrypoint migrates, compose never seeds)", "file_type": "concept", "rationale": "A bare docker compose up auto-migrates via backend/docker-entrypoint.sh but deliberately never seeds, so no default credentials ever exist in a production deployment.", "source_file": "docs/deployment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_deployment_md_seeding", "label": "Opt-in seeding and one-time admin password (NEXUSOPS_ALLOW_SEED, ENVIRONMENT=test)", "file_type": "rationale", "rationale": "Seeding is an explicit manual step (advisory-locked, idempotent, refuses in production); outside ENVIRONMENT=test the admin password is generated randomly and printed once on stderr, so shipping default credentials would otherwise be a standing backdoor.", "source_file": "docs/deployment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_deployment_md_tls_termination", "label": "TLS termination via outer reverse proxy (Option A)", "file_type": "rationale", "rationale": "The edge serves plain HTTP :8080 only and TLS is not wired up in the repo; run an outer HTTPS proxy that overwrites X-Forwarded-For and stamps X-Forwarded-Proto so the Secure cookie flag flips on automatically.", "source_file": "docs/deployment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_deployment_md_client_ip_resolution", "label": "Client IP resolution (resolve_client_ip, TRUSTED_PROXY_CIDRS, XFF overwrite)", "file_type": "rationale", "rationale": "Walk X-Forwarded-For right-to-left past trusted proxy CIDRs; the outermost controlled proxy must OVERWRITE the header at the trust boundary (not append) and nothing outside TRUSTED_PROXY_CIDRS may reach the edge directly.", "source_file": "docs/deployment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_deployment_md_backups", "label": "Backups (pgdata volume, nightly pg_dump, ephemeral Redis)", "file_type": "concept", "source_file": "docs/deployment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_deployment_md_scaling_knobs", "label": "Scaling knobs (API_WORKERS, safe worker replicas, pool budgets)", "file_type": "concept", "source_file": "docs/deployment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_deployment_md_health_endpoints", "label": "Health endpoints (/health liveness, /ready dependency check, edge probe)", "file_type": "concept", "source_file": "docs/deployment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_deployment_md_required_env_vars", "label": "Required secrets (POSTGRES_PASSWORD, JWT_SECRET >= 32 chars, ENCRYPTION_KEY Fernet)", "file_type": "concept", "source_file": "docs/deployment.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_deployment_md_document", "target": "docker_compose_yml_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deployment.md", "source_location": null, "weight": 1.0}, {"source": "docs_deployment_md_document", "target": "docker_compose_dev_yml_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/deployment.md", "source_location