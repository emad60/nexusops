: "docs/api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_md_auth", "label": "Authentication (JWT access, refresh cookie, API key, agent token)", "file_type": "concept", "source_file": "docs/api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_md_refresh_rotation", "label": "Refresh token rotation and reuse detection (TOKEN_REUSE)", "file_type": "rationale", "rationale": "Every use issues a fresh row and supersedes the old one; presenting a superseded or revoked token is treated as theft - the entire session family is revoked and audited as auth.token_reuse_detected.", "source_file": "docs/api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_md_api_keys", "label": "API keys (X-API-Key, nxo_..., scope intersection)", "file_type": "concept", "rationale": "Effective permission is the intersection of the key scopes and the owning user role; the scope check runs before the superadmin shortcut so even a superadmin-owned key cannot exceed its grant.", "source_file": "docs/api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_md_agent_ingest_api", "label": "Agent ingest API (POST /agent/hello, POST /agent/heartbeat)", "file_type": "concept", "source_file": "docs/api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_md_permission_model", "label": "Permission model (data-driven registry, require_permission, wildcard scopes)", "file_type": "rationale", "rationale": "Authorization is a data-driven registry, not role-name checks: every protected endpoint declares a codename via require_permission and denial is 403 PERMISSION_DENIED.", "source_file": "docs/api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_md_account_lockout", "label": "Invisible account lockout (5 fails -> 15 min, enumeration resistance)", "file_type": "rationale", "rationale": "Locked attempts get the same generic INVALID_CREDENTIALS envelope as wrong passwords so attackers cannot enumerate registered emails; ACCOUNT_LOCKED detail exists only in the audit/event trail.", "source_file": "docs/api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_md_bootstrap_registration", "label": "Bootstrap-only registration (first user = Owner superadmin, INVITATION_REQUIRED after)", "file_type": "rationale", "rationale": "The first account bootstraps anonymously as Owner superadmin while users is empty (advisory-locked race); afterwards registration is invite-only, so production never relies on open registration.", "source_file": "docs/api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_api_md_document", "target": "docker_compose_yml_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api.md", "source_location": null, "weight": 1.0}, {"source": "readme_command_palette", "target": "docs_api_md_rest_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api.md", "source_location": null, "weight": 1.0}, {"source": "docs_api_md_rest_api", "target": "docs_api_md_error_envelope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api.md", "source_location": null, "weight": 1.0}, {"source": "docs_api_md_rest_api", "target": "docs_api_md_cursor_pagination", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api.md", "source_location": null, "weight": 1.0}, {"source": "docs_api