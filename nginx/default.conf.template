# Edge proxy: TLS termination point in production, plain HTTP in dev.
# API_UPSTREAM / WEB_UPSTREAM are substituted from the environment by the
# nginx image entrypoint. Nginx runtime variables are written WITHOUT braces
# so they pass through envsubst untouched.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Chained-proxy topology: when this edge sits behind another TLS-terminating
# proxy (host nginx / Cloudflare in production), honor the scheme the OUTER
# proxy recorded instead of this loopback hop's plain http — the Secure flag
# on auth cookies follows it. Direct access sends no header and falls back to
# $scheme, so the standalone edge (development) is unchanged. The outer proxy
# always overwrites the header, so a browser cannot spoof it end-to-end.
map $http_x_forwarded_proto $nx_fwd_proto {
    ''      $scheme;
    default $http_x_forwarded_proto;
}

# Docker's embedded DNS. Upstreams are resolved at REQUEST time (valid=10s
# cache): a static hostname in proxy_pass is resolved once at config load and
# cached forever, so any `compose up -d` that recreates api/frontend hands out
# new container IPs and the edge 502s on every route until it restarts.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;

    # Don't advertise the exact nginx build to attackers fingerprinting the
    # edge for known CVEs (also reflected on generated error pages).
    server_tokens off;

    # Long-lived connections for log/metric WebSocket streams.
    client_max_body_size 2m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /api/ {
        # Variable upstream ⇒ runtime resolution (see resolver note above).
        # Nginx runtime variables are brace-less so envsubst passes them
        # through; the envsubst variables keep their braces.
        set $api_host ${API_UPSTREAM};
        proxy_pass http://$api_host;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nx_fwd_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;   # streaming responses (logs, SSE-style WS)
    }

    location = /health {
        access_log off;
        return 200 "edge ok\n";
    }

    location / {
        set $web_host ${WEB_UPSTREAM};
        proxy_pass http://$web_host;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $nx_fwd_proto;
        # Upgrade headers here too: vite's HMR websocket rides this route in dev.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

